<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ih2_azzurra_hand_driver</name>
  <version>0.1.0</version>
  <description>Exposes interfaces to the Prensilia IH2 Azzurra Hand</description>

  <author email="ahmed.abdelrahman@tum.de">Ahmed Abdelrahman</author>
  <maintainer email="ahmed.abdelrahman@tum.de">Ahmed Abdelrahman</maintainer>
  <url>https://github.com/af-a/ih2_azzurra_hand_driver</url>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
